---
import App from "@src/layouts/App.astro";
import EmailIcon from '~icons/mdi/email';
import GithubIcon from '~icons/mdi/github';
import LinkedinIcon from '~icons/mdi/linkedin';
import ProfileImage from "@src/assets/profile-square.png";
import TypewriterComponent from 'typewriter-effect';

const typingWords = ['WordPress', 'JavaScript', 'React', 'Astro', 'PHP', 'NodeJS', 'Cloudflare', 'Alien!'];
---
<style>
	@reference "../styles/app.css";

  .header {
    @apply grid md:grid-cols-2 gap-3 max-w-full lg:max-w-5xl mx-auto font-ibm-plex place-items-center mb-8 lg:mb-12;

    .title {
      @apply text-3xl md:text-7xl mb-6 lg:mb-8;
    }

    .content {
      p {
        @apply mb-4
      }
    }

    .picture {
      @apply relative;
    }

    .words {
      @apply absolute z-10 bottom-12 lg:bottom-18 top-0 w-full flex justify-center items-end text-4xl lg:text-6xl drop-shadow-[0_1.2px_1.2px_rgba(0,0,0,0.8)];
    }

    .profile-picture {
      @apply border-4 rounded-2xl
    }
  }

  .quick-contact {
    @apply p-2 lg:px-10 lg:py-6 rounded-2xl  max-w-full lg:max-w-5xl mx-auto bg-alt-black font-ibm-plex md:flex justify-between;

    .title {
      @apply text-xl font-semibold;
    }
  }

  .contact-points {
    @apply md:flex gap-6;

    a {
      @apply link-underline;
    }

    .item {
      @apply flex gap-1;
    }
  }
</style>
<App title='About me'>
  <div class="header">
    <div class="content">
      <h1 class="title">Greeting!</h1>
      <div class="intro">
        <p>I am Jay. A Web Developer (and stuff) with over a decade of experience across frontend and backend development, from WordPress to Astro, from PHP to JavaScript, and plenty in between. I build things, break things, fix things, and occasionally even make them work on the first try.</p>
        <p>And a father of 6 cats.</p>
      </div>
    </div>
    <div class="picture">
      <img src={ProfileImage.src} alt="This is me!" class="profile-picture"/>
      <div class="words">
        <TypewriterComponent
          client:load
          options={{
            strings: typingWords,
            autoStart: true,
            loop: true,
          }}
        />
      </div>
    </div>
  </div>
  <div class="quick-contact">
    <h2 class="title">Reach out to me!</h2>
    <ul class="contact-points">
      <li class="item">
        <EmailIcon width="24" height="24"/> <a href="mailto:me@jirayu.in.th">me@jirayu.in.th</a>
      </li>
      <li class="item">
        <GithubIcon width="24" height="24"/> <a href="https://go.jirayu.in.th/github">GitHub</a>
      </li>
      <li class="item">
        <LinkedinIcon width="24" height="24"/> <a href="https://go.jirayu.in.th/linkedin">LinkedIn</a>
      </li>
    </ul>
  </div>
</App>
