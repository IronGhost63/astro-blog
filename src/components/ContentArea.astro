---
const {content} = Astro.props;
---
<style>
  @reference "../styles/app.css";

  .content-area {
    @apply text-xl leading-9;

    p {
      @apply mb-2 lg:mb-4
    }

    h1 {
      @apply heading-1;
    }

    h2 {
      @apply heading-2;
    }

    h3 {
      @apply heading-3;
    }

    h4 {
      @apply heading-4;
    }

    h5 {
      @apply heading-5;
    }

    h6 {
      @apply heading-6;
    }

    ul {
      @apply list-disc;
    }

    ol {
      @apply list-decimal;
    }

    ul, ol {
      @apply ml-7 mb-2 lg:mb-4;
    }

    li {
      @apply pl-2;
    }

    hr {
      @apply my-6 lg:my-10 border-t-gray-900/20 border-dashed;
    }

    .wp-block-image {
      @apply my-6 lg:my-10;
    }

    .wp-block-gallery {
      @apply grid gap-2 my-6 lg:my-10;

      .wp-block-image {
        @apply my-0;
      }

      &:has(> .wp-block-image:only-child) {
        @apply max-w-120 w-full mx-auto;
      }

      &:has(> .wp-block-image:nth-child(2)) {
        @apply md:grid-cols-2;
      }

      &:has(> .wp-block-image:nth-child(3)) {
        @apply md:grid-cols-3;
      }
    }

    .wp-block-table {
      @apply my-4 md:my-8;

      table {
        @apply border border-gray-900/20 border-collapse;
      }

      th, td {
        @apply p-2 border-b border-b-gray-900/20;
      }

      thead tr {
        @apply bg-gray-900/5;
      }

      &.is-style-stripes {
        tr:nth-child(even) {
          @apply bg-gray-900/5;
        }
      }
    }
  }
</style>

<script>
  const postContent = document.querySelector('.content-area');
  const codeBlocks = postContent?.querySelectorAll('.wp-block-code code');

  if ( codeBlocks && codeBlocks.length > 0) {
    const { default:hljs } = await import("highlight.js");

    codeBlocks.forEach((code) => {
      hljs.highlightElement(code);
    });
  }
</script>

<div class="content-area" set:html={content}/>
